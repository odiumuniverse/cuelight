#compdef cuelight
# zsh completion for cuelight.
# Keyboard names come from the running binary, so a newly plugged keyboard is
# completable immediately -- nothing is baked in at install time.

_cuelight_keyboards() {
  local -a names
  # One name per line. Names contain spaces, so split on newlines only.
  names=(${(f)"$(cuelight devices --names 2>/dev/null)"})
  _describe -t keyboards 'keyboard' names
}

_cuelight_agents() {
  local -a agents
  agents=(
    'claude:Claude Code'
    'opencode:opencode'
    'gemini:Gemini CLI'
    'antigravity:Antigravity'
    'codex:Codex'
    'cursor:Cursor'
    'all:every supported agent'
  )
  _describe -t agents 'agent' agents
}

_cuelight() {
  local -a commands
  commands=(
    'devices:list keyboards and which are selected'
    'test:light a keyboard for 3s'
    'status:show tracked sessions and the current mode'
    'blink:show or set how long the lamp blinks for'
    'stats:time spent, today and over the last 7 days'
    'show:bring the menu bar icon back after hiding it'
    'hooks:print or install the agents'"'"' hook config'
  )

  _arguments -C \
    '1: :->command' \
    '*:: :->argument'

  case $state in
    command)
      _describe -t commands 'cuelight command' commands
      ;;
    argument)
      case $words[1] in
        test)
          _cuelight_keyboards
          ;;
        devices)
          _arguments '--names[print names only, for scripts]'
          ;;
        blink)
          local -a durations
          durations=(
            '5m:blink for five minutes, then go dark'
            '10m:blink for ten minutes, then go dark'
            '30m:blink for half an hour, then go dark'
            'always:blink until the session is answered'
          )
          _describe -t durations duration durations
          ;;
        stats)
          local -a periods
          periods=(
            'week:the last 7 days'
            'month:the last 30 days'
            'year:the last 365 days'
            'all:every event ever logged'
          )
          _arguments \
            '1:period:{_describe -t periods period periods}' \
            '-i[pick a period and a destination with the arrow keys]' \
            '--pick[pick a period and a destination with the arrow keys]' \
            '--json[print the numbers as JSON]' \
            '--md[print a markdown table]' \
            '--card[write a PNG card]:file:_files -g "*.png"'
          ;;
        hooks)
          case $words[2] in
            install|remove)
              _cuelight_agents
              ;;
            *)
              local -a verbs
              verbs=(
                'install:install hooks for one agent, or all'
                'remove:remove hooks for one agent, or all'
              )
              _describe -t verbs 'hooks command' verbs
              ;;
          esac
          ;;
      esac
      ;;
  esac
}

_cuelight "$@"
